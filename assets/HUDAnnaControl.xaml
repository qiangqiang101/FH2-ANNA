<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ForzaUI" 
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
    mc:Ignorable="d"
    x:Class="ForzaUI.HUDAnnaControl"
    x:Name="UserControl"
    Tag="{Binding AnnaDisplayMode}"
    >

    <UserControl.Resources>
        <ResourceDictionary>

            <!-- FH2 ANNA: what FH3's control uses that FH2 hasn't, or has under other names -->
            <local:FZMaterialPreset x:Key="FH2ANNA_Preset_Plain" />
            <!-- ANNA's buttons, its own pictures (of the pad's): a keyboard mod (FH2Mouse) finds them
                 here by name and shows its keys in them -->
            <ImageSource x:Key="FH2ANNA_Icon_Open">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_DPadDown.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Choose">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_DPadRight.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_LB.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_RB">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_RB.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_A">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_A.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_B">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_B.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_X">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_X.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_Y">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_Y.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_View">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_View.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_L3">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_L3.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Cinematic_R3">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_R3.png</ImageSource>

            <Style x:Key="FH2ANNA_Text" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_HudMedium}">
                <Setter Property="FontSize" Value="26" />
            </Style>
            <Style x:Key="FH2ANNA_GlassHudItem" TargetType="local:FZMaterial">
                <Setter Property="Color" Value="{StaticResource A_Color_HUD_ItemBackground}" />
                <Setter Property="Preset" Value="{DynamicResource A_FZMaterialPresetGlass_Standard}" />
                <Setter Property="Height" Value="36" />
            </Style>
            <!--
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Anthem/Shared_Hud.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            -->
            <Color x:Key="A_Color_Minimap_DestinationIcon">#FFFFFFFF</Color>
            <Color x:Key="A_Color_Minimap_EdgeInactive">#1AFFFFFF</Color>
            <Color x:Key="A_Color_Minimap_EdgeActive">#FFF4F444</Color>

            <Color x:Key="A_Color_ItemSelected">#FFF4F444</Color>
            <Color x:Key="A_Color_ItemHighlighted">#FFF4F444</Color>
            <System:Double x:Key="A_Double_SpeechOptionWidth">214</System:Double>
            <System:Double x:Key="A_Double_ANNAStatusFadedOpacity">0.6</System:Double>

            <SolidColorBrush x:Key="A_Brush_ANNAButtonBorder" Color="{StaticResource A_Color_Minimap_EdgeInactive}"/>

            <SolidColorBrush x:Key="A_Brush_Minimap_EdgeInactive" Color="{StaticResource A_Color_Minimap_EdgeInactive}"/>

            <ImageBrush x:Key="A_Brush_Outline" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Glow_On.png"/>
            <ImageBrush x:Key="A_Brush_Outline_ANNAOnly" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Glow_ANNAOnly.png"/>
            <ImageBrush x:Key="A_Brush_OutlineMaskGradient" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/VerticalGradient.png"/>

            <ImageBrush x:Key="A_Brush_MapOpacity" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_WithDestination" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_WithDestination.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_MapOnly" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_MapOnly.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_MapOnlyWithDestination" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_MapOnly_WithDestination.png"/>

            <Style x:Key="A_Style_FZMaterial_MapOpacity" TargetType="{x:Type local:FZMaterial}">
                <Setter Property="Color" Value="#00000000"/>
                <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_WithDestination}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_MapOnly}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding AnnaDisplayMode}" Value="2"/>
                            <Condition Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_MapOnlyWithDestination}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- pgPaulP - value converters to set the render tranform tranlation based on an angle in degrees. -->
            <local:AnglePositionConverter x:Key="A_AnglePositionConverter_NorthX" Cosine="False" ResultScale="-125" /> 
            <local:AnglePositionConverter x:Key="A_AnglePositionConverter_NorthY" Cosine="True" ResultScale="-92" />

            <Style x:Key="A_Arc_Minimap_EdgeInactive" TargetType="{x:Type ed:Arc}">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="6,10,6,4"/>
                <Setter Property="Stretch" Value="None"/>
                <Setter Property="Stroke" Value="{StaticResource A_Brush_Minimap_EdgeInactive}"/>
                <Setter Property="StrokeThickness" Value="3"/>
            </Style>

            <ExponentialEase x:Key="A_EasingFunction_EaseInOut" EasingMode="EaseInOut"/>
            <ExponentialEase x:Key="A_EasingFunction_EaseIn" EasingMode="EaseIn"/>
            <ExponentialEase x:Key="A_EasingFunction_EaseOut" EasingMode="EaseOut"/>

            <Style x:Key="A_Style_FrameworkElement_Destination" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="{x:Null}">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.175" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Arc_Minimap_EdgeInactive_LHS" TargetType="{x:Type ed:Arc}" BasedOn="{StaticResource A_Arc_Minimap_EdgeInactive}">
                <Setter Property="StartAngle" Value="213"/>
                <Setter Property="EndAngle" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="StartAngle" Value="180"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.EndAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-35" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.EndAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Arc_Minimap_EdgeInactive_RHS" TargetType="{x:Type ed:Arc}" BasedOn="{StaticResource A_Arc_Minimap_EdgeInactive}">
                <Setter Property="StartAngle" Value="0"/>
                <Setter Property="EndAngle" Value="148"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="EndAngle" Value="180"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.StartAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="35" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.StartAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- pgPaulP - Data template for the speech items in the anna popup -->
            <DataTemplate x:Key="A_DataTemplate_SpeechItem">
                <Grid x:Name="Row" Width="355" Height="34" Margin="0,1.5,0,1.5">
                    <Path x:Name="Back" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#B0383838" Data="M0,0 L318,0 L318,34 L0,34 Z"/>
                    <local:FZTextBlock x:Name="Label" Text="{Binding Command}" Style="{StaticResource FH2ANNA_Text}" FontSize="25" Margin="0,-1,45,1" Width="{StaticResource A_Double_SpeechOptionWidth}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <local:FZMaterial x:Name="MoreUp" Visibility="Collapsed" ImageSource="/ForzaUI;component/Textures/Anthem/SocialFeedIcons/Scroll_Arrow.png" Width="34" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="142,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <local:FZMaterial.RenderTransform><RotateTransform Angle="180"/></local:FZMaterial.RenderTransform>
                    </local:FZMaterial>
                    <local:FZMaterial x:Name="MoreDown" Visibility="Collapsed" ImageSource="/ForzaUI;component/Textures/Anthem/SocialFeedIcons/Scroll_Arrow.png" Width="34" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="142,0,0,0" />
                    <Canvas x:Name="TitleArea" Visibility="Collapsed" Width="355" Height="0" VerticalAlignment="Top">
                        <local:FZTextBlock x:Name="Title" Text="{Binding Command}" Style="{StaticResource FH2ANNA_Text}" FontSize="23" Color="#FFF4F444" Canvas.Bottom="8" Canvas.Right="45" Width="{StaticResource A_Double_SpeechOptionWidth}" />
                    </Canvas>
                    <local:FZMaterial x:Name="Dpad" HorizontalAlignment="Right" Width="34" Height="34" Color="#FF1A1A1A" Visibility="Hidden">
                        <local:FZMaterial ImageSource="{StaticResource FH2ANNA_Icon_Choose}" Width="28" Height="28" Color="White" />
                    </local:FZMaterial>
                    <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid x:Name="HintCinematic" Visibility="Collapsed" Canvas.Left="-171" Canvas.Top="84" Width="1600" Height="60">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:FZTextBlock Text="FH2ANNA_TEXT_CINEMATIC_BEFORE" Style="{StaticResource FH2ANNA_Text}" FontSize="40" Color="{StaticResource A_Color_HUD_Text_NoBackground}" VerticalAlignment="Center" />
                            <local:FZMaterial x:Name="HintCinematicIcon" ImageSource="{StaticResource FH2ANNA_Icon_Cinematic}" Width="40" Height="40" Margin="10,0,10,0" Color="White" VerticalAlignment="Center" />
                            <local:FZTextBlock Text="FH2ANNA_TEXT_CINEMATIC_AFTER" Style="{StaticResource FH2ANNA_Text}" FontSize="40" Color="{StaticResource A_Color_HUD_Text_NoBackground}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Grid x:Name="HintAnna" Visibility="Collapsed" Canvas.Left="-171" Canvas.Top="84" Width="1600" Height="60">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:FZTextBlock Text="FH2ANNA_TEXT_ANNA_BEFORE" Style="{StaticResource FH2ANNA_Text}" FontSize="40" Color="{StaticResource A_Color_HUD_Text_NoBackground}" VerticalAlignment="Center" />
                            <local:FZMaterial x:Name="HintAnnaIcon" ImageSource="{StaticResource FH2ANNA_Icon_Open}" Width="40" Height="40" Margin="10,0,10,0" Color="White" VerticalAlignment="Center" />
                            <local:FZTextBlock Text="FH2ANNA_TEXT_ANNA_AFTER" Style="{StaticResource FH2ANNA_Text}" FontSize="40" Color="{StaticResource A_Color_HUD_Text_NoBackground}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                    </Canvas>
                    <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid x:Name="AutoDriveOn" Visibility="Collapsed" Canvas.Left="-273" Canvas.Top="67" Width="400" Height="34">
                          <Border Background="#33383838" CornerRadius="9" Padding="8,0,8,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <local:FZTextBlock Text="FH2ANNA_TEXT_AUTODRIVE" Style="{StaticResource FH2ANNA_Text}" FontSize="25" Color="{StaticResource A_Color_HUD_Text_NoBackground}" Margin="4,-1,4,1" VerticalAlignment="Center" />
                              <local:FZTextBlock Text="FH2ANNA_TEXT_ON" Style="{StaticResource FH2ANNA_Text}" FontSize="25" Color="{StaticResource A_Color_Minimap_EdgeActive}" Margin="4,-1,4,1" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </Grid>
                    </Canvas>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Back" Property="Fill" Value="#FFF4F444" />
                        <Setter TargetName="Label" Property="Color" Value="#FF1A1A1A" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!--FH2ANNA_OFF-->
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_MORE_UP">
                        <Setter TargetName="Row" Property="Height" Value="22" />
                        <Setter TargetName="Back" Property="Fill" Value="#60383838" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="MoreUp" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_MORE_DOWN">
                        <Setter TargetName="Row" Property="Height" Value="22" />
                        <Setter TargetName="Back" Property="Fill" Value="#60383838" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="MoreDown" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_MORE_NONE">
                        <Setter TargetName="Row" Property="Height" Value="22" />
                        <Setter TargetName="Back" Property="Fill" Value="#60383838" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_LISTENING">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_AWAKE">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_ANNA">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintAnna" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_RB">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_RB}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_A">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_A}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_B">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_B}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_X">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_X}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_Y">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_Y}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_View">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_View}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_L3">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_L3}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Command}" Value="FH2ANNA_HINT_CINEMATIC_R3">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="HintCinematic" Property="Visibility" Value="Visible" />
                        <Setter TargetName="AutoDriveOn" Property="Visibility" Value="Visible" />
                        <Setter TargetName="HintCinematicIcon" Property="ImageSource" Value="{StaticResource FH2ANNA_Icon_Cinematic_R3}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}" Value="0">
                        <Setter TargetName="Row" Property="Height" Value="0" />
                        <Setter TargetName="Row" Property="Margin" Value="0" />
                        <Setter TargetName="Back" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dpad" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="TitleArea" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.OptionsList.Count, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}" Value="9"/>
                            <Condition Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}" Value="0"/>
                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Title" Property="Canvas.Bottom" Value="-17" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
