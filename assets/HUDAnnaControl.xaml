<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ForzaUI" 
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
    mc:Ignorable="d"
    x:Class="ForzaUI.HUDAnnaControl"
    x:Name="UserControl"
    >

    <UserControl.Resources>
        <ResourceDictionary>

            <!-- FH2 ANNA: what FH3's control uses that FH2 hasn't, or has under other names -->
            <local:FZMaterialPreset x:Key="FH2ANNA_Preset_Plain" />
            <!-- ANNA's buttons, its own pictures (of the pad's): a keyboard mod (FH2Mouse) finds them
                 here by name and shows its keys in them -->
            <ImageSource x:Key="FH2ANNA_Icon_Open">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_DPadDown.png</ImageSource>
            <ImageSource x:Key="FH2ANNA_Icon_Choose">/ForzaUI;component/Textures/Data_Bound/ControllerIcons/Controller_DPadRight.png</ImageSource>
            <Style x:Key="FH2ANNA_Text" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_HudMedium}">
                <Setter Property="FontSize" Value="26" />
            </Style>
            <Style x:Key="FH2ANNA_GlassHudItem" TargetType="local:FZMaterial">
                <Setter Property="Color" Value="{StaticResource A_Color_HUD_ItemBackground}" />
                <Setter Property="Preset" Value="{DynamicResource A_FZMaterialPresetGlass_Standard}" />
                <Setter Property="Height" Value="36" />
            </Style>
            <!--
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Anthem/Shared_Hud.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            -->
            <Color x:Key="A_Color_Minimap_DestinationIcon">#FFFFFFFF</Color>
            <Color x:Key="A_Color_Minimap_EdgeInactive">#1AFFFFFF</Color>
            <Color x:Key="A_Color_Minimap_EdgeActive">#FFF4F444</Color>

            <Color x:Key="A_Color_ItemSelected">#FFF4F444</Color>
            <Color x:Key="A_Color_ItemHighlighted">#FFF4F444</Color>
            <System:Double x:Key="A_Double_SpeechOptionWidth">214</System:Double>
            <System:Double x:Key="A_Double_ANNAStatusFadedOpacity">0.6</System:Double>

            <SolidColorBrush x:Key="A_Brush_ANNAButtonBorder" Color="{StaticResource A_Color_Minimap_EdgeInactive}"/>

            <SolidColorBrush x:Key="A_Brush_Minimap_EdgeInactive" Color="{StaticResource A_Color_Minimap_EdgeInactive}"/>

            <ImageBrush x:Key="A_Brush_Outline" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Glow_On.png"/>
            <ImageBrush x:Key="A_Brush_Outline_ANNAOnly" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Glow_ANNAOnly.png"/>
            <ImageBrush x:Key="A_Brush_OutlineMaskGradient" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/VerticalGradient.png"/>

            <ImageBrush x:Key="A_Brush_MapOpacity" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_WithDestination" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_WithDestination.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_MapOnly" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_MapOnly.png"/>
            <ImageBrush x:Key="A_Brush_MapOpacity_MapOnlyWithDestination" ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/Minimap_OpacityMask_MapOnly_WithDestination.png"/>

            <Style x:Key="A_Style_FZMaterial_MapOpacity" TargetType="{x:Type local:FZMaterial}">
                <Setter Property="Color" Value="#00000000"/>
                <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_WithDestination}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_MapOnly}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding AnnaDisplayMode}" Value="2"/>
                            <Condition Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="OpacityMask" Value="{StaticResource A_Brush_MapOpacity_MapOnlyWithDestination}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- pgPaulP - value converters to set the render tranform tranlation based on an angle in degrees. -->
            <local:AnglePositionConverter x:Key="A_AnglePositionConverter_NorthX" Cosine="False" ResultScale="-125" /> 
            <local:AnglePositionConverter x:Key="A_AnglePositionConverter_NorthY" Cosine="True" ResultScale="-92" />

            <Style x:Key="A_Arc_Minimap_EdgeInactive" TargetType="{x:Type ed:Arc}">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="6,10,6,4"/>
                <Setter Property="Stretch" Value="None"/>
                <Setter Property="Stroke" Value="{StaticResource A_Brush_Minimap_EdgeInactive}"/>
                <Setter Property="StrokeThickness" Value="3"/>
            </Style>

            <ExponentialEase x:Key="A_EasingFunction_EaseInOut" EasingMode="EaseInOut"/>
            <ExponentialEase x:Key="A_EasingFunction_EaseIn" EasingMode="EaseIn"/>
            <ExponentialEase x:Key="A_EasingFunction_EaseOut" EasingMode="EaseOut"/>

            <Style x:Key="A_Style_FrameworkElement_Destination" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="{x:Null}">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.175" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Arc_Minimap_EdgeInactive_LHS" TargetType="{x:Type ed:Arc}" BasedOn="{StaticResource A_Arc_Minimap_EdgeInactive}">
                <Setter Property="StartAngle" Value="213"/>
                <Setter Property="EndAngle" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="StartAngle" Value="180"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.EndAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-35" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.EndAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Arc_Minimap_EdgeInactive_RHS" TargetType="{x:Type ed:Arc}" BasedOn="{StaticResource A_Arc_Minimap_EdgeInactive}">
                <Setter Property="StartAngle" Value="0"/>
                <Setter Property="EndAngle" Value="148"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="EndAngle" Value="180"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.StartAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="35" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <BeginStoryboard.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ed:Arc.StartAngle)" Storyboard.TargetName="{x:Null}">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard.Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

