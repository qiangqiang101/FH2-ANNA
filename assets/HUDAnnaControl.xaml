            <Storyboard x:Key="A_Storyboard_PlaySleepSoundAndMinimize">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ANNAMain">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <StringAnimationUsingKeyFrames Storyboard.TargetName="AnnaSleep" Storyboard.TargetProperty="(local:AudioEvent.SoundName)">
                    <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value="" />
                    <DiscreteStringKeyFrame KeyTime="0:0:0.05" Value="/Master/UI/ANNA/HZ2_SFX_HUD_ANNA_Sleep_01" />
                </StringAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="A_Storyboard_PlayWakeSoundAndShowFull">
                <StringAnimationUsingKeyFrames Storyboard.TargetName="AnnaWake" Storyboard.TargetProperty="(local:AudioEvent.SoundName)">
                    <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value="" />
                    <DiscreteStringKeyFrame KeyTime="0:0:0.01" Value="/Master/UI/ANNA/HZ2_SFX_HUD_ANNA_Wake_01" />
                </StringAnimationUsingKeyFrames>
                <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_On">
                    <EasingSingleKeyFrame KeyTime="0:0:0.5" Value="0.8" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                </SingleAnimationUsingKeyFrames>
                <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_On">
                    <EasingSingleKeyFrame KeyTime="0:0:0.5" Value="0.65" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                </SingleAnimationUsingKeyFrames>
                <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                    <EasingSingleKeyFrame KeyTime="0:0:0.4" Value="1" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                </SingleAnimationUsingKeyFrames>
                <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                    <DiscreteSingleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                    <EasingSingleKeyFrame KeyTime="0:0:0.5" Value="1" EasingFunction="{StaticResource A_EasingFunction_EaseInOut}"/>
                </SingleAnimationUsingKeyFrames>
                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(local:FZMaterial.Color)" Storyboard.TargetName="ANNAMic">
                    <EasingColorKeyFrame KeyTime="0:0:0.5" Value="{StaticResource A_Color_Minimap_EdgeActive}" EasingFunction="{StaticResource A_EasingFunction_EaseOut}"/>
                </ColorAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="A_Style_ANNAStatusMarkup_ANNA" TargetType="{x:Type Control}">
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <local:FZMaterial ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Logo.png" Width="59" Height="18"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="A_Style_ANNAStatusMarkup_ANNA_FADED" TargetType="{x:Type Control}" BasedOn="{StaticResource A_Style_ANNAStatusMarkup_ANNA}">
                <Setter Property="Opacity" Value="{StaticResource A_Double_ANNAStatusFadedOpacity}"/>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_ANNAAvailable_DPad" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="{Binding IsAvailable, Converter={StaticResource A_FZBooleanToVisibilityConverter}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVoiceAvailable}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasValidInputCmd}"
                                 Value="False">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_ANNAUnavailable"
                   TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility"
                        Value="{Binding IsAvailable, Converter={StaticResource A_FZBooleanToVisibilityConverter_Inverse}}" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasValidInputCmd}"
                                        Value="False" />
                            <Condition Binding="{Binding IsVoiceAvailable}"
                                       Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_HideIfANNAOnly" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="4">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="1">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="A_Style_FrameworkElement_HideIfMapOnly" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="4">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="2">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_HideIfOff" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_ShowIfANNAOnly" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="1">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FrameworkElement_ShowIfOn" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="3">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FZMaterial_ANNAOptions_Mask" TargetType="{x:Type Grid}">
                <Setter Property="Height" Value="300"/>
                <Setter Property="Width" Value="300"/>
                <Setter Property="Margin" Value="31,0,0,45"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="3">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="Margin" Value="-4,7,0,-12"/>
                        <Setter Property="Width" Value="430"/>
                        <Setter Property="OpacityMask">
                            <Setter.Value>
                                <RadialGradientBrush GradientOrigin="0.259,0.5" Center="0.259,0.5" RadiusX="0.267" RadiusY="0.517">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.99"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_FrameworkElement_ANNAOptions" TargetType="{x:Type FrameworkElement}">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AnnaDisplayMode}" Value="3">
                        <Setter Property="Width" Value="430"/>
                        <Setter Property="Margin" Value="150,0,0,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="A_Style_FZMaterial_EdgeGlow" TargetType="{x:Type local:FZMaterial}" >
                <Setter Property="Preset" Value="{StaticResource FH2ANNA_Preset_Plain}"/>
                <Setter Property="Width" Value="310"/>
                <Setter Property="Height" Value="310"/>
                <Setter Property="Margin" Value="-5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <local:TextureMaskEffect Texture="{StaticResource A_Brush_Outline}" Mask="{StaticResource A_Brush_OutlineMaskGradient}" Color="{StaticResource A_Color_Minimap_EdgeActive}" FadeInStart="0" FadeInEnd="0" FadeOutStart="0" FadeOutEnd="0"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="A_Style_FZMaterial_EdgeGlow_ANNAOnly" TargetType="{x:Type local:FZMaterial}" BasedOn="{StaticResource A_Style_FZMaterial_EdgeGlow}">
                <Setter Property="Width" Value="179"/>
                <Setter Property="Height" Value="54"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <local:TextureMaskEffect Texture="{StaticResource A_Brush_Outline_ANNAOnly}" Mask="{StaticResource A_Brush_OutlineMaskGradient}" Color="{StaticResource A_Color_Minimap_EdgeActive}" FadeInStart="0" FadeInEnd="0" FadeOutStart="0" FadeOutEnd="0"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Style="{StaticResource A_Style_FrameworkElement_HideIfOff}" Margin="59,0,0,-30">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup">
                <VisualState x:Name="ShowMinimized">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ANNAMain">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ANNAMain">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="EventFire">
                            <DiscreteStringKeyFrame KeyTime="0:0:0" Value="Reset"/>
                        </StringAnimationUsingKeyFrames>
                        <StringAnimationUsingKeyFrames Storyboard.TargetProperty="(local:EventFire.EventName)" Storyboard.TargetName="EventFire">
                            <DiscreteStringKeyFrame KeyTime="0:0:0.25" Value="SelectComplete"/>
                        </StringAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_On">
                            <DiscreteSingleKeyFrame KeyTime="0" Value="0.8"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_On">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="0.65"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                            <DiscreteSingleKeyFrame KeyTime="0" Value="1"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                        </SingleAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(local:FZMaterial.Color)" Storyboard.TargetName="ANNAMic">
                            <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="{StaticResource A_Color_Minimap_EdgeActive}"/>
                        </ColorAnimationUsingKeyFrames>
                        <StringAnimationUsingKeyFrames Storyboard.TargetName="AnnaSelect" Storyboard.TargetProperty="(local:AudioEvent.SoundName)">
                            <DiscreteStringKeyFrame KeyTime="0:0:0.0" Value="" />
                            <DiscreteStringKeyFrame KeyTime="0:0:0.01" Value="/Master/UI/ANNA/HZ2_SFX_HUD_ANNA_Wake_01" />
                        </StringAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="ShowFull">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ANNAMain">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_On">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="0.8"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_On">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="0.65"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutEnd)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                        </SingleAnimationUsingKeyFrames>
                        <SingleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(FadeOutStart)" Storyboard.TargetName="EdgeGlow_ANNAOnly">
                            <DiscreteSingleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                        </SingleAnimationUsingKeyFrames>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(local:FZMaterial.Color)" Storyboard.TargetName="ANNAMic">
                            <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="{StaticResource A_Color_Minimap_EdgeActive}"/>
                        </ColorAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Hide">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="LayoutRoot" Duration="0:0:1">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.5" From="ShowFull" To="ShowMinimized" Storyboard="{StaticResource A_Storyboard_PlaySleepSoundAndMinimize}" />
                    <VisualTransition GeneratedDuration="0:0:0.5" From="ShowMinimized" To="ShowFull" Storyboard="{StaticResource A_Storyboard_PlayWakeSoundAndShowFull}" />
                </VisualStateGroup.Transitions>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="HUDAnnaControl_MiniMap" Style="{StaticResource A_Style_FrameworkElement_HideIfANNAOnly}">
            <Grid Width="300" Height="300" HorizontalAlignment="Left" Margin="-4,0,0,-12">
                <ed:Arc x:Name="ArcLHS" Style="{StaticResource A_Arc_Minimap_EdgeInactive_LHS}"/>
                <ed:Arc x:Name="ArcRHS" Style="{StaticResource A_Arc_Minimap_EdgeInactive_RHS}"/>
                <Grid>
                    <StackPanel Style="{StaticResource A_Style_FrameworkElement_Destination}" MinHeight="32" Height="Auto" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding DestinationDistance, Converter={StaticResource A_StringVisConverter}}" HorizontalAlignment="Center" Margin="-1.5,11,0,0">
                        <local:FZMaterial Color="{StaticResource A_Color_Minimap_DestinationIcon}" ImageSource="/ForzaUI;component/Textures/Anthem/HUD/MinimapWaypointIcon.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,-2,8,0"/>
                        <local:FZTextBlock Text="{Binding DestinationDistance, Converter={StaticResource A_StringToUpper}}" Style="{StaticResource FH2ANNA_Text}" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,-2,0,0"/>
                    </StackPanel>

                    <local:FZMaterial Style="{StaticResource A_Style_FZMaterial_MapOpacity}">
                        <local:MapCustomRenderElement Alpha="1.0" MapId="default" MapProfile="hud" x:Name="mapCustomRenderElement">
                            <local:MapCustomRenderElement.MapView>
                                <local:MapViewControllerTrackingMiniMap IsRotatedToCarHeading="true"
                                                                        MinSpeed="2.0"
                                                                        MaxSpeed="50.0"
                                                                        MinDistance="300.0"
                                                                        MaxDistance="500.0"
                                                                        MinFOV="55.0"
                                                                        MaxFOV="55.0"
                                                                        MinElevation="60.0"
                                                                        MaxElevation="60.0"
                                                                        PositionInViewportY="-0.3"
                                                                        PositionInViewportX="0.0"
                                                                        MaxiumProjectionSize="2400" />
                            </local:MapCustomRenderElement.MapView>
                        </local:MapCustomRenderElement>
                    </local:FZMaterial>

                    <local:FZMaterial Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" ImageSource="/ForzaUI;component/Textures/Anthem/HUD/NorthIndicator.png" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,0">
                        <local:FZMaterial.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="{Binding NorthAngle, Converter={StaticResource A_AnglePositionConverter_NorthX}}" Y="{Binding NorthAngle, Converter={StaticResource A_AnglePositionConverter_NorthY}}"/>
                            </TransformGroup>
                        </local:FZMaterial.RenderTransform>
                    </local:FZMaterial>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="HUDAnnaControl_ANNAStatus" Style="{StaticResource A_Style_FrameworkElement_HideIfMapOnly}">
            <Border BorderBrush="{StaticResource A_Brush_ANNAButtonBorder}" CornerRadius="9" BorderThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="67,0,0,0" Width="156">
                <Viewbox Width="142" Height="30" Stretch="Uniform" StretchDirection="DownOnly">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <local:FZMaterial x:Name="ANNAMic" Width="0" Height="0" Visibility="Collapsed" />
                        <local:FZMaterial ImageSource="{StaticResource FH2ANNA_Icon_Open}" Width="25" Height="25" Margin="0,0,6,0" Color="White" VerticalAlignment="Center" />
                        <local:FZMaterial ImageSource="/ForzaUI;component/Textures/Data_Bound/FH2ANNA/ANNA_Logo.png" Width="59" Height="18" VerticalAlignment="Center" />
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>

        <Canvas x:Name="HUDAnnaControl_ANNAOptions" Style="{StaticResource A_Style_FrameworkElement_HideIfMapOnly}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="0" Height="0" Margin="146,0,0,135">
            <Grid Canvas.Left="72" Canvas.Top="-505" Height="1000">
                <StackPanel x:Name="ANNAMain" Orientation="Vertical" VerticalAlignment="Center" Width="355">
                    <local:CommonListBox AlternationCount="14" ItemsSource="{Binding OptionsList}" ItemTemplate="{StaticResource A_DataTemplate_SpeechItem}" Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Margin="0,0,0,0" Style="{x:Null}" VerticalAlignment="Center">
                        <local:CommonListBox.Template>
                            <ControlTemplate TargetType="{x:Type local:CommonListBox}">
                                <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                            </ControlTemplate>
                        </local:CommonListBox.Template>
                        <local:CommonListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </local:CommonListBox.ItemContainerStyle>
                    </local:CommonListBox>
                </StackPanel>
            </Grid>
        </Canvas>

        <Grid x:Name="HUDAnnaControl_EdgeGlow" Style="{StaticResource A_Style_FrameworkElement_ShowIfOn}">
            <local:FZMaterial x:Name="EdgeGlow_On" Style="{StaticResource A_Style_FZMaterial_EdgeGlow}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-8,0,0,-15"/>
        </Grid>

        <Grid x:Name="HUDAnnaControl_EdgeGlowANNAOnly" Style="{StaticResource A_Style_FrameworkElement_ShowIfANNAOnly}">
            <local:FZMaterial x:Name="EdgeGlow_ANNAOnly" Style="{StaticResource A_Style_FZMaterial_EdgeGlow_ANNAOnly}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="57,0,0,-10"/>
        </Grid>

        <local:EventFire x:Name="EventFire" />
        <local:AudioEvent x:Name="AnnaWake" />
        <local:AudioEvent x:Name="AnnaSelect"/>
        <local:AudioEvent x:Name="AnnaSleep" />

    </Grid>
</UserControl>
