                    <local:FZMaterial x:Name="MoreUp" Visibility="Collapsed" ImageSource="/ForzaUI;component/Textures/Anthem/SocialFeedIcons/Scroll_Arrow.png" Width="34" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="117,0,0,0" RenderTransformOrigin="0.5,0.5">
